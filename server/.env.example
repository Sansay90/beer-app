# Скопировать в .env и поправить. compose.yaml читает его сам.

# IP пивоварни в домашней сети. Лучше закрепить его за пивоварней в роутере (DHCP-резервация),
# иначе после перезагрузки роутера адрес может смениться.
BREWERY_IP=192.168.0.104

# версия протокола Tuya модуля пивоварни (видна в tools/probe.py dump)
BREWERY_VERSION=3.4

TZ=Europe/Moscow

# пароль Postgres (сервис db в compose.yaml) — придумать свой
POSTGRES_PASSWORD=change-me
# для посредника, запущенного локально из .venv, к базе в Docker
DATABASE_URL=postgresql+psycopg://brewapp:change-me@127.0.0.1:5433/brewapp

# Web Push: закрытый ключ сервера — сгенерировать: python -m bridge.push. Сменишь — браузеры подпишутся заново.
VAPID_PRIVATE_KEY=
# контакт владельца сервера для push-сервисов браузеров (mailto: или https://)
VAPID_SUBJECT=mailto:brewapp@example.com
