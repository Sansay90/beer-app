# /opt/brewapp/.env на сервере. Секреты — только здесь, в репозиторий и в GitHub не попадают.

TZ=Europe/Moscow
# пароль Postgres — длинный случайный
POSTGRES_PASSWORD=

# адрес сайта: ссылки в письмах и проверка, что запросы пришли с него
APP_URL=https://example.com
# почты администраторов через запятую; остальные регистрируются пользователями
ADMIN_EMAILS=

# Web Push: закрытый ключ сервера (python -m app.push) и контакт владельца для push-сервисов
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# письма: подтверждение почты и новый пароль. Пусто — письма только в журнале сервиса (не для открытой регистрации)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
