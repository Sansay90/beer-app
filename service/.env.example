# Скопировать в .env и поправить. Сервис (python -m app) и compose.yaml читают его сами. Настройки агента — в agent/.env.

TZ=Europe/Moscow

# пароль Postgres (сервис db в compose.yaml) — придумать свой
POSTGRES_PASSWORD=change-me
# для сервиса, запущенного локально из .venv, к базе в Docker
DATABASE_URL=postgresql+psycopg://brewapp:change-me@127.0.0.1:5433/brewapp

# Вход. APP_URL — адрес сайта (ссылки в письмах); пусто — сервис у себя на ПК, ссылки ведут на адрес из браузера.
APP_URL=
# почты администраторов через запятую; пусто — администратор первый зарегистрировавшийся
ADMIN_EMAILS=
# письма: подтверждение почты и новый пароль. Пусто — письма только в журнале сервиса
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Web Push: закрытый ключ сервера — сгенерировать: python -m app vapid. Сменишь — браузеры подпишутся заново.
VAPID_PRIVATE_KEY=
# контакт владельца сервера для push-сервисов браузеров (mailto: или https://)
VAPID_SUBJECT=mailto:brewapp@example.com
