# Скопировать в .env и поправить. Агент читает его сам, compose.yaml сервиса — тоже (env_file).

# адрес сервиса для агентов; в Docker compose подставляет свой
SERVICE_URL=ws://127.0.0.1:8000/api/agent
# токен агента — выдаёт сервис: в brewapp/service  .venv\Scripts\python -m app.agents new
AGENT_TOKEN=

# IP пивоварни в домашней сети. Лучше закрепить его за пивоварней в роутере (DHCP-резервация),
# иначе после перезагрузки роутера адрес может смениться. Пусто — искать широковещанием (из Docker не работает).
BREWERY_IP=
# версия протокола Tuya модуля пивоварни (видна в tools/probe.py dump)
BREWERY_VERSION=3.4

# потолок мощности, W, — только если модели пивоварни нет в списке (agent/recipe.py, MODEL_MAX_WATTS)
MAX_WATTS=
